# Auto detach on SIGHUP

autodetach on

# Caption

caption always '%{= kw}%= [ %S: %{y}%t%{-} ] %='

# Hardstatus

hardstatus string '%{= dd}%-Lw%40L>%{+b}%n*%f%t%{-}%+Lw%<'
hardstatus alwayslastline

# huge scrollback buffer

defscrollback 10000

# no welcome message

startup_message off

# UTF-8

defutf8 on

# 256 colors

attrcolor b ".I"
termcapinfo xterm 'Co#256:AB=\E[48;5;%dm:AF=\E[38;5;%dm'
defbce on

# get rid of silly xoff stuff

bind s split
