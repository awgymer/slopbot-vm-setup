# Interactive shells. ~/.bashrc sources this file, and ~/.bashrc returns
# early for a non-interactive shell, so the parts that every shell needs
# are in ~/.bash_tools, which ~/.bash_profile sources for a login shell.
source "${HOME}/.bash_tools"

# Files made here take the agent's own group, which ubuntu belongs to. sudo
# and PAM set this as well; this covers a shell started some other way.
umask 007

alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# Each agent user has its own directory under WORKSPACE_ROOT, which is set
# globally via /etc/environment. /etc/profile.d sets WORKSPACE for a login
# shell; this covers the others.
export WORKSPACE="${WORKSPACE:-${WORKSPACE_ROOT:-/workspace}/$(id -un)}"
cd "$WORKSPACE" 2>/dev/null || true

# Apptainer and Nextflow image caches, in the workspace. /etc/profile.d sets
# these for a login shell as well; this covers the others.
export APPTAINER_CACHEDIR="${APPTAINER_CACHEDIR:-${WORKSPACE}/.apptainer/cache}"
export SINGULARITY_CACHEDIR="${SINGULARITY_CACHEDIR:-$APPTAINER_CACHEDIR}"
export NXF_APPTAINER_CACHEDIR="${NXF_APPTAINER_CACHEDIR:-${WORKSPACE}/.apptainer/images}"
export NXF_SINGULARITY_CACHEDIR="${NXF_SINGULARITY_CACHEDIR:-$NXF_APPTAINER_CACHEDIR}"
mkdir -p "$APPTAINER_CACHEDIR" "$NXF_APPTAINER_CACHEDIR" 2>/dev/null

# Claude
alias cc='claude'
alias riskycc='claude --dangerously-skip-permissions'
