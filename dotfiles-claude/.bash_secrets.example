# Credentials and identity for the claude agent user.
# Copy to ~/.bash_secrets and fill in values. Never commit ~/.bash_secrets.

# Anthropic
# export ANTHROPIC_API_KEY=sk-ant-...

# GitHub (gh auth setup-git is run automatically when this is set)
# export GH_TOKEN=ghp_...

# Git identity (used for commits)
# export GIT_AUTHOR_NAME="Your Name"
# export GIT_AUTHOR_EMAIL="you@example.com"
# export GIT_COMMITTER_NAME="Your Name"
# export GIT_COMMITTER_EMAIL="you@example.com"
